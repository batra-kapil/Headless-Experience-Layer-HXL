// Generated by scripts/apply-image-base-url.js. Updates Image_URL__c on existing demo records.
Map<String, String> urlsByName = new Map<String, String>{
    'Tesla Roadster' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/tesla-roadster.jpg',
    'Tesla Model 3' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/tesla-model-3.jpg',
    'Toyota RAV4' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/toyota-rav4.jpg',
    'Mahindra XUV700' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/mahindra-xuv700.jpg',
    'Honda City' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/honda-city.jpg',
    'BMW 5 Series' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/bmw-5-series.jpg',
    'Ford Mustang Convertible' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/ford-mustang-convertible.jpg',
    'Maruti Suzuki Swift' => 'https://raw.githubusercontent.com/batra-kapil/roadster-rentals-assets/main/cars/maruti-suzuki-swift.jpg'
};
List<Rental_Vehicle__c> vehicles = [SELECT Id, Name FROM Rental_Vehicle__c WHERE Name IN :urlsByName.keySet()];
for (Rental_Vehicle__c vehicle : vehicles) {
    vehicle.Image_URL__c = urlsByName.get(vehicle.Name);
}
update vehicles;
System.debug('Updated ' + vehicles.size() + ' vehicles');
