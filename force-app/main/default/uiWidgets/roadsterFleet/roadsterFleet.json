{
  "type": "lightning__agentforceWidget",
  "contentBody": {
    "widgetBody": {
      "definition": "tile/widget",
      "children": [
        {
          "definition": "tile/column",
          "attributes": {
            "gap": "md"
          },
          "children": [
            {
              "definition": "tile/column",
              "attributes": {
                "gap": "xs"
              },
              "children": [
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "Roadster Rentals",
                    "variant": "caption",
                    "weight": "semibold",
                    "color": "primary"
                  }
                },
                {
                  "definition": "tile/text",
                  "attributes": {
                    "text": "{!$attrs.headline}",
                    "variant": "h1"
                  }
                }
              ]
            },
            {
              "definition": "tile/container",
              "meta": {
                "if": "{!$attrs.hasFeatured}",
                "forEach": "{!$attrs.featuredCars}",
                "forItem": "$hero"
              },
              "attributes": {
                "variant": "emphasis"
              },
              "children": [
                {
                  "definition": "tile/column",
                  "attributes": {
                    "gap": "sm"
                  },
                  "children": [
                    {
                      "definition": "tile/image",
                      "attributes": {
                        "src": "{!$hero.imageUrl}",
                        "alt": "{!$hero.name}",
                        "size": "full"
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm",
                        "justify": "between"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.name}",
                            "variant": "h2"
                          }
                        },
                        {
                          "definition": "tile/badge",
                          "attributes": {
                            "label": "Featured",
                            "variant": "primary"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$hero.tagline}",
                        "variant": "body",
                        "isItalic": true
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "xs",
                        "align": "center"
                      },
                      "children": [
                        {
                          "definition": "tile/icon",
                          "attributes": {
                            "name": "map-pin",
                            "size": "xs",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.location}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.seatsLabel}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "|",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.transmission}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "|",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.fuelType}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "|",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.rangeLabel}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/text",
                      "attributes": {
                        "text": "{!$hero.ratingLabel}",
                        "variant": "caption",
                        "color": "muted"
                      }
                    },
                    {
                      "definition": "tile/row",
                      "attributes": {
                        "gap": "md",
                        "justify": "between"
                      },
                      "children": [
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$hero.dailyRateLabel}",
                            "variant": "h3",
                            "color": "primary"
                          }
                        },
                        {
                          "definition": "tile/button",
                          "attributes": {
                            "label": "Book",
                            "variant": "secondary",
                            "actions": {
                              "click": [
                                {
                                  "definition": "action/sendMessage",
                                  "attributes": {
                                    "content": "{!$hero.bookMessage}"
                                  }
                                }
                              ]
                            }
                          }
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            {
              "definition": "tile/callout",
              "meta": {
                "if": "{!$attrs.isEmpty}"
              },
              "attributes": {
                "variant": "info",
                "title": "No cars match this search",
                "description": "Try another pickup location, category or a higher daily budget."
              }
            },
            {
              "definition": "tile/container",
              "meta": {
                "forEach": "{!$attrs.cars}",
                "forItem": "$car"
              },
              "children": [
                {
                  "definition": "tile/row",
                  "attributes": {
                    "gap": "md",
                    "align": "start"
                  },
                  "children": [
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "width": "sm"
                      },
                      "children": [
                        {
                          "definition": "tile/image",
                          "attributes": {
                            "src": "{!$car.imageUrl}",
                            "alt": "{!$car.name}",
                            "size": "full"
                          }
                        }
                      ]
                    },
                    {
                      "definition": "tile/column",
                      "attributes": {
                        "gap": "xs",
                        "width": "stretch"
                      },
                      "children": [
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm",
                            "justify": "between"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.name}",
                                "variant": "h3"
                              }
                            },
                            {
                              "definition": "tile/badge",
                              "attributes": {
                                "label": "{!$car.category}",
                                "variant": "secondary"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$car.tagline}",
                            "variant": "caption"
                          }
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "xs",
                            "align": "center"
                          },
                          "children": [
                            {
                              "definition": "tile/icon",
                              "attributes": {
                                "name": "map-pin",
                                "size": "xs",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.location}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "sm"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.seatsLabel}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "|",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.transmission}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "|",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.fuelType}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "|",
                                "variant": "caption",
                                "color": "muted"
                              }
                            },
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.rangeLabel}",
                                "variant": "caption",
                                "color": "muted"
                              }
                            }
                          ]
                        },
                        {
                          "definition": "tile/text",
                          "attributes": {
                            "text": "{!$car.ratingLabel}",
                            "variant": "caption",
                            "color": "muted"
                          }
                        },
                        {
                          "definition": "tile/row",
                          "attributes": {
                            "gap": "md",
                            "justify": "between"
                          },
                          "children": [
                            {
                              "definition": "tile/text",
                              "attributes": {
                                "text": "{!$car.dailyRateLabel}",
                                "variant": "h4",
                                "color": "primary"
                              }
                            },
                            {
                              "definition": "tile/button",
                              "attributes": {
                                "label": "Book",
                                "variant": "secondary",
                                "actions": {
                                  "click": [
                                    {
                                      "definition": "action/sendMessage",
                                      "attributes": {
                                        "content": "{!$car.bookMessage}"
                                      }
                                    }
                                  ]
                                }
                              }
                            }
                          ]
                        }
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  }
}
